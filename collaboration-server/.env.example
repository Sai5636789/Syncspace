# SyncSpace collaboration server — local environment.
# Copy to .env and fill in real values. Never commit a filled-in .env.
# Every value here must match the backend / Docker Compose setup.

# Port the Yjs WebSocket server listens on.
COLLAB_PORT=3001
COLLAB_HOST=0.0.0.0

# Spring Boot backend base URL (membership checks). In Docker Compose
# this is http://backend:8080; locally http://localhost:8080.
BACKEND_URL=http://localhost:8080

# PostgreSQL connection string for document_updates / document_snapshots.
# In Docker Compose this is
# postgres://syncspace:<POSTGRES_PASSWORD>@postgres:5432/syncspace
DATABASE_URL=postgres://syncspace:syncspace@[::1]:5432/syncspace?sslmode=disable

# HMAC secret the backend signs JWT access tokens with. MUST match the
# backend's JWT_SECRET (default in backend application.yml is the local
# dev secret). Generate a real secret for any shared deployment.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Snapshot policy: write a snapshot after this many persisted updates,
# at most once per interval for dirty documents, and when the last
# client leaves a document.
COLLAB_SNAPSHOT_EVERY_UPDATES=50
COLLAB_SNAPSHOT_INTERVAL_MS=60000
