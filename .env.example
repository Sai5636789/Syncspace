# SyncSpace local environment. Copy to .env and fill in real values.
# Never commit a filled-in .env — secrets stay out of the repository.

# PostgreSQL
POSTGRES_USER=syncspace
POSTGRES_PASSWORD=syncspace_dev_password
POSTGRES_DB=syncspace
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring Boot backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Generate a real secret for any shared deployment (at least 32 chars).
# Example: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Angular frontend
FRONTEND_PORT=4200
API_URL=http://localhost:8080

# Yjs collaboration server
COLLAB_PORT=3001
COLLAB_PUBLIC_URL=http://localhost:3001
BACKEND_URL=http://localhost:8080
DATABASE_URL=postgres://syncspace:syncspace@[::1]:5432/syncspace?sslmode=disable
COLLAB_SNAPSHOT_EVERY_UPDATES=50
COLLAB_SNAPSHOT_INTERVAL_MS=60000

# Nginx reverse proxy
NGINX_PORT=80
